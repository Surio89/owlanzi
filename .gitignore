# Build output and editor state
.pio/
.vscode/

# Older copies kept aside while developing
backup/
*.bak

# NEVER PUBLISH THIS.
# It holds Wi-Fi and Owlet credentials in plain text, and its string literals
# end up INSIDE THE COMPILED IMAGE. Anyone handing out a .bin built with this
# file present is handing out their passwords. See src/main.cpp and
# tools/make-installer.ps1 - the published image is built by the "release"
# environment, which excludes this file on purpose.
src/secrets_local.h

# Working files: fetched pages, logs, screenshots. A screenshot of the web
# interface can show your own email address.
tools/scratch/
*.log
served.html
served.js
served-setup.html
bootlog.txt
*.png
!assets/**/*.png

# OS clutter
Thumbs.db
.DS_Store
