/*
 * secrets_local.h.example - Vorlage, nur fuers Entwickeln.
 *
 * Kopiere die Datei nach src/secrets_local.h und trage deine Daten ein, wenn
 * du beim Testen nicht jedes Mal durch den Einrichtungs-Hotspot willst. Beim
 * ersten Start schreibt main.cpp die Werte einmalig in den NVS.
 *
 * ACHTUNG, und das ist kein Formsatz: die Werte landen beim Uebersetzen ALS
 * KLARTEXT IM ABBILD. Eine so gebaute .bin darf nicht weitergegeben werden -
 * sie traegt dein WLAN- und dein Owlet-Passwort mit sich herum. Genau das
 * ist in diesem Projekt einmal passiert.
 *
 * Was veroeffentlicht wird, baut deshalb die PlatformIO-Umgebung "release"
 * (mit -DNO_LOCAL_SECRETS), und tools/make-installer.ps1 durchsucht das
 * fertige Abbild danach noch einmal und bricht ab, wenn es doch etwas findet.
 *
 * src/secrets_local.h steht in .gitignore. Diese Vorlage nicht.
 */
#pragma once
#define SEED_WIFI_SSID  "mein-wlan"
#define SEED_WIFI_PASS  "mein-wlan-passwort"
#define SEED_OWLET_MAIL "ich@example.com"
#define SEED_OWLET_PASS "mein-owlet-passwort"
