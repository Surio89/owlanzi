/*
 * secrets_local.h.example - template, for development only.
 *
 * Copy this to src/secrets_local.h and fill in your own values if you don't
 * want to walk through the setup hotspot on every test. On first boot
 * main.cpp writes them into the NVS once.
 *
 * A warning that is not boilerplate: these values end up AS PLAIN TEXT
 * INSIDE THE COMPILED IMAGE. A .bin built with this file present must never
 * be handed to anyone - it carries your Wi-Fi and Owlet passwords with it.
 * That has already happened once in this project.
 *
 * Anything published is therefore built by the PlatformIO environment
 * "release" (with -DNO_LOCAL_SECRETS), and tools/make-installer.ps1 scans the
 * finished image for these strings and aborts if it finds one.
 *
 * src/secrets_local.h is in .gitignore. This template is not.
 */
#pragma once
#define SEED_WIFI_SSID  "my-wifi"
#define SEED_WIFI_PASS  "my-wifi-password"
#define SEED_OWLET_MAIL "me@example.com"
#define SEED_OWLET_PASS "my-owlet-password"
